NODE_ENV=development
PORT=3000
LOG_LEVEL=info
MAX_FILE_SIZE_MB=5
UPLOAD_DIR=./uploads
UPLOAD_RATE_LIMIT_WINDOW_MS=900000
UPLOAD_RATE_LIMIT_MAX=20
DATABASE_URL=mysql://epic_user:epic_password@127.0.0.1:3306/epic_imports
DB_MIGRATE_ON_START=true
DB_SSL=false
DB_POOL_MIN=0
DB_POOL_MAX=10
DB_POOL_ACQUIRE_MS=30000
