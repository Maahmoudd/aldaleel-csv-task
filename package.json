{
  "name": "epic-csv-data-import",
  "version": "1.0.0",
  "description": "Production-ready CSV customer import service built with Express",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "db:migrate": "node src/database/cli.js migrate",
    "db:migrate:undo": "node src/database/cli.js migrate:undo",
    "db:seed": "node src/database/cli.js seed",
    "db:seed:undo": "node src/database/cli.js seed:undo",
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.1",
    "multer": "^2.0.2",
    "mysql2": "^3.14.4",
    "pino": "^9.9.0",
    "pino-http": "^10.5.0",
    "sequelize": "^6.37.7",
    "umzug": "^3.8.2",
    "zod": "^4.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "eslint": "^9.34.0",
    "globals": "^16.3.0",
    "nodemon": "^3.1.10",
    "prettier": "^3.6.2"
  },
  "overrides": {
    "sequelize": {
      "uuid": "^11.1.1"
    }
  }
}
